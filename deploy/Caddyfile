# Caddy: HTTPS с автоматическим получением и продлением сертификатов (ADR-004).
{
	email {$ACME_EMAIL}
}

{$PUBLIC_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API, webhook бота, трекинговые ссылки — в backend.
	handle /api/* {
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Короткие отслеживаемые ссылки: /r/<код> → API (переход и учёт клика).
	handle /r/* {
		rewrite * /api{uri}
		reverse_proxy api:3000 {
			header_up X-Request-Id {http.request.uuid}
		}
	}

	# Статика Mini App. Telegram Web открывает Mini App во фрейме — X-Frame-Options
	# не ставим, источник фрейма ограничивает CSP frame-ancestors.
	# 'unsafe-inline' для script-src нужен для встроенных скриптов статической сборки Next.js.
	handle {
		root * /srv/web
		header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://telegram.org; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; media-src 'self' blob:; connect-src 'self'; frame-ancestors https://web.telegram.org https://*.telegram.org; base-uri 'self'; form-action 'self'; object-src 'none'"
		@immutable path /_next/static/*
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		# Страницы и служебные файлы сборки — всегда проверять свежесть: иначе WebView
		# Telegram может показывать старую версию приложения после обновления.
		@pages not path /_next/static/*
		header @pages Cache-Control "no-cache"
		try_files {path} {path}/index.html /404.html
		file_server
	}
}
