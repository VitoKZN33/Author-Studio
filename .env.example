# Author Studio — конфигурация установки.
# Скопируйте в .env и заполните. Файл .env не коммитится (права: chmod 600 .env).
# Все значения ниже — примеры, не используйте их как настоящие.

# --- Домен и HTTPS ---
# Домен, указывающий A-записью на этот сервер. Сертификат Caddy получит сам.
PUBLIC_DOMAIN=studio.example.ru
# Почта для уведомлений Let's Encrypt о сертификатах.
ACME_EMAIL=admin@example.ru

# --- Установка ---
APP_NAME=Author Studio
APP_TIMEZONE=Europe/Moscow
LOG_LEVEL=info

# --- База данных ---
POSTGRES_USER=author_studio
POSTGRES_DB=author_studio
# Только латиница и цифры (используется в адресе подключения). Сгенерировать: openssl rand -hex 24
POSTGRES_PASSWORD=change-me-generate-with-openssl

# --- Шифрование секретов в БД (32 байта base64). Сгенерировать: openssl rand -base64 32
# Потеря ключа = потеря сохранённых в приложении ключей интеграций. Храните копию отдельно.
APP_ENCRYPTION_KEY=

# --- Telegram ---
# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=
# Ваш числовой Telegram ID (владелец установки). Узнать: напишите @userinfobot.
OWNER_TELEGRAM_ID=
# Секрет webhook. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# Если сервер не может подключиться к api.telegram.org (частая ситуация в дата-центрах РФ):
# прокси для запросов к Bot API — socks5://логин:пароль@хост:порт или http://хост:порт.
# TELEGRAM_PROXY_URL=
# Получение обновлений: webhook (Telegram присылает на ваш домен) или polling (сервер сам
# забирает обновления; не нужны входящие соединения от Telegram — выбирайте вместе с прокси).
# TELEGRAM_UPDATES_MODE=webhook
# Регистрировать webhook, меню и команды бота при запуске (по умолчанию — в production).
# TELEGRAM_AUTO_SETUP=true

# --- Аналитика ---
# Как часто снимать число подписчиков, минут (по умолчанию 30).
# METRICS_SUBSCRIBERS_INTERVAL_MINUTES=30

# --- Вход в Mini App ---
# Срок действия данных входа Telegram, секунд (по умолчанию 3600).
# AUTH_INIT_DATA_MAX_AGE_SECONDS=3600
# Срок сессии, часов (по умолчанию 12).
# SESSION_TTL_HOURS=12
# Попыток входа в минуту с одного адреса (по умолчанию 10).
# AUTH_LOGIN_RATE_LIMIT=10

# Документация API (/api/docs). В production по умолчанию выключена.
ENABLE_API_DOCS=false

# Как часто забирать просмотры через аккаунт владельца (раздел «Ещё → Просмотры»), минут.
# VIEWS_SYNC_INTERVAL_MINUTES=60
